<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:padding="20dp" />

        <!-- APPEARANCE -->
        <TextView style="@style/SettingsSectionHeader" android:text="@string/section_appearance" />

        <LinearLayout android:id="@+id/rowTextColor" style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsRowTextContainer">
                <TextView style="@style/SettingsRowTitle" android:text="@string/text_color" />
            </LinearLayout>
            <View android:id="@+id/swatchTextColor" style="@style/SettingsSwatch" />
        </LinearLayout>
        <View style="@style/SettingsDivider" />

        <LinearLayout android:id="@+id/rowBackgroundColor" style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsRowTextContainer">
                <TextView style="@style/SettingsRowTitle" android:text="@string/background_color" />
            </LinearLayout>
            <View android:id="@+id/swatchBackgroundColor" style="@style/SettingsSwatch" />
        </LinearLayout>
        <View style="@style/SettingsDivider" />

        <LinearLayout android:id="@+id/rowFont" style="@style/SettingsRow" android:orientation="vertical" android:gravity="start">
            <TextView style="@style/SettingsRowTitle" android:text="@string/font" />
            <Spinner
                android:id="@+id/spinnerFont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
        <View style="@style/SettingsDivider" />

        <LinearLayout android:id="@+id/rowImportFont" style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsRowTextContainer">
                <TextView style="@style/SettingsRowTitle" android:text="@string/import_font_file" />
                <TextView android:id="@+id/textCustomFontStatus" style="@style/SettingsRowSubtitle" />
            </LinearLayout>
        </LinearLayout>
        <View style="@style/SettingsDivider" />

        <!-- PRIORITY COLORS -->
        <TextView style="@style/SettingsSectionHeader" android:text="@string/section_priority_colors" />

        <LinearLayout android:id="@+id/rowHighColor" style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsRowTextContainer">
                <TextView style="@style/SettingsRowTitle" android:text="@string/high_priority_color" />
            </LinearLayout>
            <View android:id="@+id/swatchHighColor" style="@style/SettingsSwatch" />
        </LinearLayout>
        <View style="@style/SettingsDivider" />

        <LinearLayout android:id="@+id/rowMediumColor" style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsRowTextContainer">
                <TextView style="@style/SettingsRowTitle" android:text="@string/medium_priority_color" />
            </LinearLayout>
            <View android:id="@+id/swatchMediumColor" style="@style/SettingsSwatch" />
        </LinearLayout>
        <View style="@style/SettingsDivider" />

        <LinearLayout android:id="@+id/rowNormalColor" style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsRowTextContainer">
                <TextView style="@style/SettingsRowTitle" android:text="@string/normal_priority_color" />
            </LinearLayout>
            <View android:id="@+id/swatchNormalColor" style="@style/SettingsSwatch" />
        </LinearLayout>
        <View style="@style/SettingsDivider" />

        <LinearLayout android:id="@+id/rowHighlightColor" style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsRowTextContainer">
                <TextView style="@style/SettingsRowTitle" android:text="@string/highlight_color" />
            </LinearLayout>
            <View android:id="@+id/swatchHighlightColor" style="@style/SettingsSwatch" />
        </LinearLayout>
        <View style="@style/SettingsDivider" />

        <!-- ALARMS -->
        <TextView style="@style/SettingsSectionHeader" android:text="@string/section_alarms" />

        <LinearLayout android:id="@+id/rowAlarmSound" style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsRowTextContainer">
                <TextView style="@style/SettingsRowTitle" android:text="@string/alarm_sound" />
                <TextView android:id="@+id/textAlarmSoundStatus" style="@style/SettingsRowSubtitle" />
            </LinearLayout>
        </LinearLayout>
        <View style="@style/SettingsDivider" />

        <!-- MORE -->
        <TextView style="@style/SettingsSectionHeader" android:text="@string/section_more" />

        <LinearLayout android:id="@+id/rowWidgetSettings" style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsRowTextContainer">
                <TextView style="@style/SettingsRowTitle" android:text="@string/widget_settings_title" />
            </LinearLayout>
        </LinearLayout>
        <View style="@style/SettingsDivider" />

        <LinearLayout android:id="@+id/rowTeachWords" style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsRowTextContainer">
                <TextView style="@style/SettingsRowTitle" android:text="@string/teach_title" />
            </LinearLayout>
        </LinearLayout>
        <View style="@style/SettingsDivider" />

        <LinearLayout android:id="@+id/rowResetDefaults" style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsRowTextContainer">
                <TextView style="@style/SettingsRowTitle" android:text="@string/reset_defaults" android:textColor="#D32F2F" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</ScrollView>
