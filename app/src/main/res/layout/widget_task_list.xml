<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="2dp">

    <ImageView
        android:id="@+id/widgetAddButtonExpanded"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_widget_add_button"
        android:scaleType="fitCenter"
        android:padding="2dp"
        android:contentDescription="@string/add_task" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp">

        <ImageView
            android:id="@+id/widgetCapsuleBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/capsule_mask"
            android:scaleType="fitXY" />

        <ListView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:divider="#22000000"
            android:dividerHeight="1dp"
            android:scrollbars="none"
            android:cacheColorHint="@android:color/transparent" />

        <TextView
            android:id="@android:id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/no_upcoming_tasks"
            android:textColor="#9E9E9E" />

    </FrameLayout>

</LinearLayout>
