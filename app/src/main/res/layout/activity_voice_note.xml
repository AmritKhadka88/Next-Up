<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1A1A2E"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imageMicIndicator"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_widget_add_button"
        android:contentDescription="@string/voice_input" />

    <TextView
        android:id="@+id/textVoiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:text="@string/voice_listening" />

    <TextView
        android:id="@+id/textVoiceLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textSize="14sp"
        android:textColor="#BBBBBB"
        android:gravity="center" />

    <Button
        android:id="@+id/buttonStopVoiceMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/stop_voice_mode" />

</LinearLayout>
